# Public access. Use the server IP for the first smoke test, then replace with a domain.
SITE_HOST=168.144.36.82
MOODLE_WWWROOT=http://168.144.36.82
TZ=Asia/Shanghai

# Pin source/image versions for reproducibility.
MOODLE_BRANCH=MOODLE_405_STABLE
FLOWISE_VERSION=3.0.13
QDRANT_VERSION=v1.18.3
MARIADB_VERSION=10.11.18
CADDY_VERSION=2.11.4

# Moodle / MariaDB. Replace every example secret before deployment.
MARIADB_DATABASE=moodle
MARIADB_USER=moodle
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=replace-with-a-long-random-password
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_FULLNAME=电力系统储能技术
MOODLE_SHORTNAME=storage-course
MOODLE_SEED_COURSE=true

# Moodle Outgoing & Inbound Email (SMTP)
# Example for QQ Mail: smtp.qq.com:465 with SSL, or smtp.exmail.qq.com:465
MOODLE_SMTP_HOST=ssl://smtp.qq.com:465
MOODLE_SMTP_USER=registrar_off@qq.com
MOODLE_SMTP_PASS=replace-with-qq-mail-smtp-auth-code
MOODLE_SMTP_SECURE=ssl
MOODLE_SMTP_AUTHTYPE=LOGIN
MOODLE_NOREPLY_ADDRESS=registrar_off@qq.com
MOODLE_SUPPORT_EMAIL=registrar_off@qq.com
MOODLE_SUPPORT_NAME=电力系统储能技术教学团队
MOODLE_EMAIL_ENABLE_REGISTRATION=true

# Xingchen Workflow API. Real values stay only in the server-side .env.
XINGCHEN_WORKFLOW_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
XINGCHEN_FLOW_ID=replace-with-published-workflow-id
XINGCHEN_API_KEY=replace-with-workflow-api-key
XINGCHEN_API_SECRET=replace-with-workflow-api-secret
XINGCHEN_INPUT_NAME=AGENT_USER_INPUT
XINGCHEN_TIMEOUT_SECONDS=90
AGENT_UID_SALT=replace-with-a-long-random-salt
AGENT_BRIDGE_TOKEN=replace-with-a-long-random-bridge-token
AGENT_RATE_LIMIT=20
AGENT_RATE_WINDOW_SECONDS=60
AGENT_USER_CONCURRENCY=1
AGENT_MAX_INPUT_CHARS=4000
MOCK_AUTH_MODE=false
MOCK_WORKFLOW_MODE=false

# Flowise persistence and administrative login.
FLOWISE_USERNAME=flowise-admin
FLOWISE_PASSWORD=replace-with-a-long-random-password
FLOWISE_SECRETKEY_OVERWRITE=replace-with-a-long-random-secret
FLOWISE_CORS_ORIGINS=http://168.144.36.82

# Qdrant is internal-only. The ingestion job and Flowise use this key.
QDRANT_API_KEY=replace-with-a-long-random-secret
QDRANT_COLLECTION=storage-course-v1

# OpenAI-compatible model gateway. Leave blank and enable MOCK_MODE for infrastructure tests.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
MODEL_GATEWAY_MOCK_MODE=false
MOCK_EMBEDDINGS=false
MOCK_EMBEDDING_DIMENSION=64
