{
    admin off
    email 2713215449@qq.com
}

{$SITE_HOST} {
    encode gzip

    @agent path /agent /agent/*
    handle @agent {
        reverse_proxy agent-ui:80
    }

    # Only the adapter is exposed on the application origin. The adapter owns
    # Moodle session validation and the server-side Xingchen credentials.
    # All course-facing API routes are owned by the Adapter. Keeping this as
    # one same-origin prefix prevents graph, assessment, scenario and KB calls
    # from falling through to Moodle and producing misleading 404 pages.
    @course_agent_api path /api/* /health
    handle @course_agent_api {
        reverse_proxy agent-adapter:8081
    }

    # Dedicated single-course workspace routing: visiting root or Moodle course catalogs directly lands on /agent/
    redir / /agent/ 302
    redir /index.php /agent/ 302
    redir /my /agent/ 302
    redir /my/ /agent/ 302
    redir /my/index.php /agent/ 302
    redir /my/courses.php /agent/ 302
    redir /course/index.php /agent/ 302
    redir /user/view.php /agent/ 302
    redir /user/profile.php /agent/ 302

    handle {
        reverse_proxy moodle:80
    }
}

