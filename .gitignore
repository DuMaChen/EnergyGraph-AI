.agent/
.agents/
.claude/
.codex/
.cursor/
.gemini/
.trellis/
.idea/
.vscode/
*.swp
*.swo

# Competition submission structure (02/03/05 tracked on GitHub; 04/06/07 kept
# as empty placeholders via .gitkeep). Local-only evidence lives in 06 but
# stays out of the repository.
/06-效果验证报告/acceptance/




# Runtime backups and throw-away sync areas (contain DB dumps and data snapshots)
backups/
tmp-sync/
