{
  "name": "energygraph-learning-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test:all": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --testNamePattern='domain|client'",
    "test:component": "vitest run --config vitest.config.ts --testNamePattern='component'",
    "test:hardening": "vitest run --config vitest.config.ts --testNamePattern='ErrorBoundary|client diagnostics'",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:axe": "playwright test --config playwright.axe.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
